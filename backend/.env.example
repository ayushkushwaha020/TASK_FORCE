APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173

# Legacy single provider. Set protocol to one of:
# openai_compatible, anthropic_messages, gemini_generate_content
AI_API_KEY=
AI_PROVIDER_PROTOCOL=openai_compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_VERSION=2026-10-21
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_OUTPUT_FIELD=max_tokens
AI_FALLBACK_MODEL=
AI_PROVIDER_NAME=default-provider
AI_PROVIDER_PRIORITY=10

# Multiple providers (JSON array; keys stay server-side).
# Protocols: openai_compatible, anthropic_messages, gemini_generate_content.
# Each entry: name, protocol, base_url, api_key, model.
# Optional: priority, max_requests_per_hour, max_output_tokens, max_output_field, api_version, fallback_model.
# Example:
# AI_PROVIDERS_JSON=[{"name":"openai-main","protocol":"openai_compatible","base_url":"https://api.openai.com/v1","api_key":"YOUR_KEY","model":"YOUR_MODEL","priority":10,"max_requests_per_hour":100},{"name":"gemini-main","protocol":"gemini_generate_content","base_url":"https://generativelanguage.googleapis.com/v1beta","api_key":"YOUR_GEMINI_KEY","model":"YOUR_GEMINI_MODEL","priority":20,"max_requests_per_hour":80},{"name":"claude-main","protocol":"anthropic_messages","base_url":"https://api.anthropic.com","api_key":"YOUR_ANTHROPIC_KEY","model":"YOUR_CLAUDE_MODEL","priority":30,"max_requests_per_hour":40,"max_output_tokens":4096,"api_version":"2026-10-21"}]
AI_PROVIDERS_JSON=

AI_REQUEST_TIMEOUT_SECONDS=60

# Supabase Postgres connection string. Keep this secret in Render backend Environment only.
# For Render IPv4 networking, choose Supabase Shared Pooler -> Session mode (port 5432).
# Transaction mode (port 6543) is also accepted; the adapter disables asyncpg statement caching.
# Copy the PostgreSQL URI from Supabase Dashboard -> Connect.
DATABASE_URL=

TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_MAX_QUERIES_PER_TASK=4
TAVILY_MAX_RESULTS_PER_QUERY=4
TAVILY_TIMEOUT_SECONDS=25
