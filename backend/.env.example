APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
# Legacy single OpenAI-compatible endpoint:
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_FALLBACK_MODEL=
AI_PROVIDER_NAME=default-compatible
AI_PROVIDER_PRIORITY=10
# Or configure multiple OpenAI-compatible endpoints (keys stay server-side):
# AI_PROVIDERS_JSON=[{"name":"provider-one","base_url":"https://example.com/v1","api_key":"replace-me","model":"model-name","priority":10,"max_requests_per_hour":30}]
AI_PROVIDERS_JSON=
AI_REQUEST_TIMEOUT_SECONDS=60
